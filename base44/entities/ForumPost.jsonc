{
  "name": "ForumPost",
  "type": "object",
  "properties": {
    "topic_id": {
      "type": "string",
      "description": "ID du sujet parent"
    },
    "content": {
      "type": "string",
      "description": "Contenu de la r\u00e9ponse"
    },
    "author": {
      "type": "string",
      "description": "ID de l'auteur"
    },
    "author_name": {
      "type": "string",
      "description": "Nom de l'auteur"
    },
    "author_email": {
      "type": "string",
      "description": "Email de l'auteur"
    },
    "is_solution": {
      "type": "boolean",
      "default": false,
      "description": "Est une solution marqu\u00e9e"
    },
    "likes_count": {
      "type": "number",
      "default": 0,
      "description": "Nombre de J'aime"
    }
  },
  "required": [
    "topic_id",
    "content",
    "author"
  ]
}