{
  "name": "AppModuleStatus",
  "type": "object",
  "properties": {
    "module_name": {
      "type": "string",
      "description": "Nom du module (messagerie, portfolio, blog, etc)"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Module actif ou non"
    },
    "status": {
      "type": "string",
      "enum": [
        "operational",
        "degraded",
        "maintenance",
        "offline"
      ],
      "default": "operational",
      "description": "Statut du module"
    },
    "message": {
      "type": "string",
      "description": "Message informatif (ex: maintenance en cours)"
    }
  },
  "required": [
    "module_name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}