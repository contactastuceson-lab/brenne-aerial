{
  "name": "Notification",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "quote_accepted",
        "quote_refused",
        "quote_pending",
        "new_message",
        "appointment",
        "system",
        "badge",
        "blog"
      ]
    },
    "is_read": {
      "type": "boolean",
      "default": false
    },
    "link": {
      "type": "string"
    }
  },
  "required": [
    "user_email",
    "title",
    "type"
  ]
}