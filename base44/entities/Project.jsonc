{
  "name": "Project",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Titre du projet"
    },
    "description": {
      "type": "string",
      "description": "Description"
    },
    "category": {
      "type": "string",
      "enum": [
        "evenement",
        "inspection",
        "chantier",
        "particulier",
        "entreprise",
        "formation"
      ],
      "description": "Cat\u00e9gorie"
    },
    "media_type": {
      "type": "string",
      "enum": [
        "image",
        "youtube",
        "tiktok",
        "instagram",
        "vimeo"
      ],
      "default": "image"
    },
    "media_url": {
      "type": "string",
      "description": "URL de la vid\u00e9o ou image principale"
    },
    "thumbnail_url": {
      "type": "string",
      "description": "URL de la miniature"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "client_name": {
      "type": "string"
    },
    "date_realisation": {
      "type": "string",
      "format": "date"
    },
    "is_featured": {
      "type": "boolean",
      "default": false
    },
    "is_published": {
      "type": "boolean",
      "default": true
    },
    "order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "title",
    "category"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": true,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}