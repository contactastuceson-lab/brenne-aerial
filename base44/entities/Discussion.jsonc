{
  "name": "Discussion",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Titre du sujet"
    },
    "content": {
      "type": "string",
      "description": "Contenu initial"
    },
    "category": {
      "type": "string",
      "enum": [
        "general",
        "technique",
        "aide",
        "partages",
        "autres"
      ],
      "default": "general",
      "description": "Cat\u00e9gorie"
    },
    "author_id": {
      "type": "string",
      "description": "ID de l'auteur"
    },
    "author_name": {
      "type": "string",
      "description": "Nom de l'auteur (snapshot)"
    },
    "author_display_name": {
      "type": "string",
      "description": "Nom d'affichage de l'auteur (snapshot)"
    },
    "author_username": {
      "type": "string",
      "description": "Username de l'auteur (snapshot)"
    },
    "author_avatar": {
      "type": "string",
      "description": "Avatar de l'auteur (snapshot)"
    },
    "author_is_supreme": {
      "type": "boolean",
      "default": false,
      "description": "L'auteur a le statut Supr\u00eame"
    },
    "author_verifications": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Certifications de l'auteur"
    },
    "author_certification_badge": {
      "type": "string",
      "description": "Badge de certification de l'auteur (URL)"
    },
    "author_badges": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Badges de l'auteur"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Tags"
    },
    "replies_count": {
      "type": "number",
      "default": 0
    },
    "views_count": {
      "type": "number",
      "default": 0
    },
    "last_reply_at": {
      "type": "string",
      "format": "date-time"
    },
    "is_locked": {
      "type": "boolean",
      "default": false,
      "description": "Sujet verrouill\u00e9 (plus de r\u00e9ponses)"
    },
    "is_pinned": {
      "type": "boolean",
      "default": false,
      "description": "Sujet \u00e9pingl\u00e9 en haut"
    },
    "is_official": {
      "type": "boolean",
      "default": false,
      "description": "Sujet officiel Brenne Aerial"
    },
    "is_announcement": {
      "type": "boolean",
      "default": false,
      "description": "Annonce affich\u00e9e en banni\u00e8re dans le forum"
    },
    "announcement_text": {
      "type": "string",
      "description": "Texte de l'annonce (si is_announcement = true)"
    }
  },
  "required": [
    "title",
    "content",
    "author_id"
  ],
  "rls": {
    "create": {
      "data.author_id": "{{user.id}}"
    },
    "read": null,
    "update": {
      "$or": [
        {
          "data.author_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.author_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}