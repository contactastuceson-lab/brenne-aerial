{
  "name": "CreditTransaction",
  "type": "object",
  "properties": {
    "owner_id": {
      "type": "string",
      "description": "ID de l'utilisateur concern\u00e9 par le mouvement"
    },
    "type": {
      "type": "string",
      "enum": [
        "transfer_in",
        "transfer_out",
        "wallet_move",
        "admin_credit",
        "admin_debit",
        "reward",
        "boutique_spend"
      ],
      "description": "Type de mouvement de cr\u00e9dits"
    },
    "amount": {
      "type": "number",
      "description": "Montant (positif = entr\u00e9e, n\u00e9gatif = sortie)"
    },
    "counterparty_id": {
      "type": "string",
      "description": "ID de l'autre partie (exp\u00e9diteur ou destinataire)"
    },
    "counterparty_name": {
      "type": "string",
      "description": "Nom de l'autre partie (snapshot)"
    },
    "counterparty_username": {
      "type": "string",
      "description": "Username de l'autre partie (snapshot)"
    },
    "from_wallet_name": {
      "type": "string",
      "description": "Nom du portefeuille source"
    },
    "to_wallet_name": {
      "type": "string",
      "description": "Nom du portefeuille destination"
    },
    "note": {
      "type": "string",
      "description": "Note / m\u00e9mo"
    },
    "status": {
      "type": "string",
      "enum": [
        "completed",
        "pending",
        "failed"
      ],
      "default": "completed"
    }
  },
  "required": [
    "owner_id",
    "type",
    "amount"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "data.owner_id": "{{user.id}}"
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}