{
  "name": "SupportTicket",
  "type": "object",
  "properties": {
    "subject": {
      "type": "string",
      "description": "Sujet / r\u00e9sum\u00e9 court de la demande"
    },
    "description": {
      "type": "string",
      "description": "Description d\u00e9taill\u00e9e du probl\u00e8me (\u00e9tape 1 du wizard)"
    },
    "file_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Pi\u00e8ces jointes (photos, vid\u00e9os, documents) \u2014 URLs upload\u00e9es"
    },
    "related_item_id": {
      "type": "string",
      "description": "ID de l'\u00e9l\u00e9ment concern\u00e9 (post, discussion, portefeuille, \u00e9v\u00e9nement\u2026) si applicable"
    },
    "related_item_type": {
      "type": "string",
      "enum": [
        "post",
        "conversation",
        "wallet",
        "event",
        "community",
        "space",
        "story",
        "referral",
        "registration",
        "reward",
        "cart",
        "ticket",
        "discussion",
        "forum",
        "review",
        "certification",
        "donation",
        "list",
        "ad",
        "none"
      ],
      "default": "none",
      "description": "Type d'\u00e9l\u00e9ment concern\u00e9 : post, conversation, wallet, event, community, space, story, referral, registration, reward, cart, ticket, discussion, forum, review, certification, donation, list, ad, ou aucun"
    },
    "related_item_label": {
      "type": "string",
      "description": "Libell\u00e9 de l'\u00e9l\u00e9ment concern\u00e9 (snapshot)"
    },
    "user_id": {
      "type": "string",
      "description": "ID de l'utilisateur"
    },
    "user_email": {
      "type": "string",
      "description": "Email de l'utilisateur (snapshot)"
    },
    "user_name": {
      "type": "string",
      "description": "Nom de l'utilisateur (snapshot)"
    },
    "category": {
      "type": "string",
      "enum": [
        "account",
        "billing",
        "credits",
        "bug",
        "feature",
        "events",
        "moderation",
        "messaging",
        "other"
      ],
      "default": "other",
      "description": "Cat\u00e9gorie (compte, facturation, cr\u00e9dits, bug, fonctionnalit\u00e9, \u00e9v\u00e9nements, mod\u00e9ration, messagerie, autre)"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "urgent"
      ],
      "default": "medium",
      "description": "Priorit\u00e9 d\u00e9termin\u00e9e par l'IA"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "ai_resolved",
        "awaiting_human",
        "resolved",
        "closed"
      ],
      "default": "open",
      "description": "open = en cours, ai_resolved = r\u00e9solu par l'IA (info), awaiting_human = escalad\u00e9 humain, resolved = r\u00e9solu, closed = ferm\u00e9"
    },
    "assignee": {
      "type": "string",
      "enum": [
        "ai",
        "human",
        "unassigned"
      ],
      "default": "unassigned",
      "description": "Responsable du ticket : ai (Nexus), human (humain), unassigned (non assign\u00e9)"
    },
    "handled_by": {
      "type": "string",
      "enum": [
        "ai",
        "human",
        "escalated"
      ],
      "default": "ai",
      "description": "Dernier responsable du traitement (legacy) : ai, human, escalated"
    },
    "user_locked": {
      "type": "boolean",
      "default": false,
      "description": "Verrouill\u00e9 par l'utilisateur \u2014 emp\u00eache toute nouvelle r\u00e9ponse tant que non confirm\u00e9"
    },
    "admin_label": {
      "type": "string",
      "description": "Label / tag administratif interne (ex: VIP, litige, suivi)"
    },
    "pending_action": {
      "type": "object",
      "description": "Action propos\u00e9e par Nexus : { type, label, params, status: pending|executed|rejected|failed, proposed_at, result }"
    },
    "last_action_log": {
      "type": "string",
      "description": "Derni\u00e8re action ex\u00e9cut\u00e9e par Nexus (log lisible)"
    },
    "messages": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "default": [],
      "description": "Fil de conversation : { role, content, steps, at, attachments, action, feedback }"
    },
    "ai_summary": {
      "type": "string",
      "description": "R\u00e9sum\u00e9 IA de la demande"
    },
    "ai_handled": {
      "type": "boolean",
      "default": false,
      "description": "Trait\u00e9 automatiquement par l'IA"
    },
    "escalation_reason": {
      "type": "string",
      "description": "Raison de l'escalade humaine si applicable"
    },
    "admin_notes": {
      "type": "string",
      "description": "Notes internes admin"
    },
    "satisfaction": {
      "type": "string",
      "enum": [
        "up",
        "down"
      ],
      "description": "Sondage de satisfaction utilisateur (up = satisfait, down = insatisfait)"
    }
  },
  "required": [
    "subject",
    "user_email"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "owner"
          }
        },
        {
          "user_condition": {
            "role": "pdg_adjoint"
          }
        },
        {
          "user_condition": {
            "role": "conseil_admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "owner"
          }
        },
        {
          "user_condition": {
            "role": "pdg_adjoint"
          }
        },
        {
          "user_condition": {
            "role": "conseil_admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "owner"
          }
        },
        {
          "user_condition": {
            "role": "pdg_adjoint"
          }
        },
        {
          "user_condition": {
            "role": "conseil_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "owner"
          }
        },
        {
          "user_condition": {
            "role": "pdg_adjoint"
          }
        },
        {
          "user_condition": {
            "role": "conseil_admin"
          }
        }
      ]
    }
  }
}