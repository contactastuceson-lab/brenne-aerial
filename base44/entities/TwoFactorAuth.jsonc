{
  "name": "TwoFactorAuth",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email de l'utilisateur"
    },
    "method": {
      "type": "string",
      "enum": [
        "email",
        "sms",
        "totp"
      ],
      "description": "Méthode 2FA"
    },
    "is_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Si la 2FA est activée"
    },
    "is_verified": {
      "type": "boolean",
      "default": false,
      "description": "Si la vérification est complète"
    },
    "totp_secret": {
      "type": "string",
      "description": "Secret TOTP chiffré (pour authenticator app)"
    },
    "backup_codes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Codes de secours chiffrés"
    },
    "phone_number": {
      "type": "string",
      "description": "Numéro de téléphone pour SMS"
    },
    "phone_verified": {
      "type": "boolean",
      "default": false
    },
    "email_address": {
      "type": "string",
      "description": "Email alternatif pour 2FA"
    },
    "email_verified": {
      "type": "boolean",
      "default": false
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_used": {
      "type": "string",
      "format": "date-time",
      "description": "Dernière utilisation"
    },
    "is_primary": {
      "type": "boolean",
      "default": true,
      "description": "Si c'est la méthode principale"
    }
  },
  "required": [
    "user_email",
    "method"
  ]
}
