{
  "name": "BeforeAfterGallery",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Titre de la comparaison"
    },
    "category": {
      "type": "string",
      "enum": [
        "inspection",
        "immobilier",
        "evenement",
        "retouche",
        "chantier"
      ],
      "description": "Cat\u00e9gorie"
    },
    "before_url": {
      "type": "string",
      "description": "URL image avant"
    },
    "after_url": {
      "type": "string",
      "description": "URL image apr\u00e8s"
    },
    "before_label": {
      "type": "string",
      "default": "Avant",
      "description": "Label gauche"
    },
    "after_label": {
      "type": "string",
      "default": "Apr\u00e8s",
      "description": "Label droite"
    },
    "description": {
      "type": "string"
    },
    "is_published": {
      "type": "boolean",
      "default": true
    },
    "order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "title",
    "before_url",
    "after_url"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "data.is_published": true
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}