{
  "name": "Community",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nom de la communaut\u00e9"
    },
    "slug": {
      "type": "string",
      "description": "Slug identifiant la communaut\u00e9"
    },
    "description": {
      "type": "string",
      "description": "Description de la communaut\u00e9"
    },
    "cover_url": {
      "type": "string",
      "description": "Image de couverture"
    },
    "category": {
      "type": "string",
      "enum": [
        "tech",
        "business",
        "art",
        "music",
        "gaming",
        "sport",
        "formation",
        "social",
        "other"
      ],
      "default": "other",
      "description": "Cat\u00e9gorie th\u00e9matique"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Tags / mots-cl\u00e9s"
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "R\u00e8gles de la communaut\u00e9"
    },
    "owner_id": {
      "type": "string",
      "description": "ID du cr\u00e9ateur"
    },
    "owner_name": {
      "type": "string",
      "description": "Nom du cr\u00e9ateur (snapshot)"
    },
    "owner_username": {
      "type": "string",
      "description": "Username du cr\u00e9ateur (snapshot)"
    },
    "owner_avatar": {
      "type": "string",
      "description": "Avatar du cr\u00e9ateur (snapshot)"
    },
    "type": {
      "type": "string",
      "enum": [
        "open",
        "closed"
      ],
      "default": "open",
      "description": "open = publique, closed = ferm\u00e9e (membres uniquement)"
    },
    "member_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs des membres"
    },
    "members_count": {
      "type": "number",
      "default": 0,
      "description": "Nombre de membres"
    },
    "posts_count": {
      "type": "number",
      "default": 0,
      "description": "Nombre de posts dans la communaut\u00e9"
    },
    "is_premium": {
      "type": "boolean",
      "default": false,
      "description": "Design premium appliqu\u00e9 (token boutique)"
    },
    "is_pinned": {
      "type": "boolean",
      "default": false,
      "description": "Communaut\u00e9 \u00e9pingl\u00e9e en haut de la liste (token boutique)"
    },
    "pinned_until": {
      "type": "string",
      "format": "date-time",
      "description": "Date d'expiration de l'\u00e9pinglage"
    },
    "capacity_limit": {
      "type": "number",
      "default": 100,
      "description": "Capacit\u00e9 maximale de membres (\u00e9tendue via token boutique)"
    }
  },
  "required": [
    "name",
    "owner_id"
  ],
  "rls": {
    "create": {
      "data.owner_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.type": "open"
        },
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "data.member_ids": "{{user.id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}