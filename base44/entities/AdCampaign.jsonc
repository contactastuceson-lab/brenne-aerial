{
  "name": "AdCampaign",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Titre de la campagne publicitaire"
    },
    "advertiser_name": {
      "type": "string",
      "description": "Nom de l'annonceur"
    },
    "image_url": {
      "type": "string",
      "description": "Image / cr\u00e9a publicitaire"
    },
    "cta_url": {
      "type": "string",
      "description": "URL de destination au clic"
    },
    "cta_label": {
      "type": "string",
      "default": "En savoir plus",
      "description": "Libell\u00e9 du bouton d'appel \u00e0 l'action"
    },
    "headline": {
      "type": "string",
      "description": "Titre accrocheur affich\u00e9 dans l'emplacement"
    },
    "body": {
      "type": "string",
      "description": "Texte descriptif de l'annonce"
    },
    "placement": {
      "type": "string",
      "enum": [
        "feed_banner",
        "between_posts",
        "sidebar"
      ],
      "default": "feed_banner",
      "description": "Emplacement de l'annonce dans l'app"
    },
    "target_hashtags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Hashtags cibl\u00e9s (optionnel)"
    },
    "impressions": {
      "type": "number",
      "default": 0,
      "description": "Nombre d'impressions servies"
    },
    "clicks": {
      "type": "number",
      "default": 0,
      "description": "Nombre de clics enregistr\u00e9s"
    },
    "budget_credits": {
      "type": "number",
      "default": 0,
      "description": "Budget total initial en cr\u00e9dits Eza (d\u00e9bit\u00e9 du solde business \u00e0 la cr\u00e9ation)"
    },
    "daily_budget": {
      "type": "number",
      "default": 10,
      "description": "Budget journalier en cr\u00e9dits Eza \u2014 d\u00e9duit chaque jour de credits_remaining"
    },
    "credits_remaining": {
      "type": "number",
      "default": 0,
      "description": "Cr\u00e9dits restants sur la campagne \u2014 quand \u00e0 0, la campagne est mise en pause auto"
    },
    "auto_paused_reason": {
      "type": "string",
      "description": "Raison de la mise en pause automatique (ex: credits_insufficient)"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "paused",
        "ended"
      ],
      "default": "draft",
      "description": "Statut de la campagne \u2014 draft = en attente de validation admin, active = en ligne, paused = en pause (cr\u00e9dits \u00e9puis\u00e9s ou manuel)"
    },
    "starts_at": {
      "type": "string",
      "format": "date-time",
      "description": "Date de d\u00e9but"
    },
    "ends_at": {
      "type": "string",
      "format": "date-time",
      "description": "Date de fin"
    },
    "owner_id": {
      "type": "string",
      "description": "ID du cr\u00e9ateur (admin ou business)"
    }
  },
  "required": [
    "title",
    "placement",
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": true,
    "update": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}