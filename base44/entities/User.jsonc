{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "user",
        "vip",
        "collaborateur",
        "pilote"
      ],
      "default": "user"
    },
    "bio": {
      "type": "string",
      "description": "Biographie de l'utilisateur"
    },
    "avatar_url": {
      "type": "string",
      "description": "URL de la photo de profil"
    },
    "cover_url": {
      "type": "string",
      "description": "URL de la photo de couverture"
    },
    "phone": {
      "type": "string"
    },
    "location": {
      "type": "string",
      "description": "Ville / localisation"
    },
    "website": {
      "type": "string",
      "description": "Lien vers le site web"
    },
    "badges": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Badges attribu\u00e9s",
      "default": []
    },
    "verified_status": {
      "type": "string",
      "enum": [
        "yes",
        "no"
      ],
      "default": "no",
      "description": "Compte v\u00e9rifi\u00e9 par un admin"
    },
    "account_status": {
      "type": "string",
      "enum": [
        "active",
        "suspended",
        "banned",
        "restricted"
      ],
      "default": "active",
      "description": "Statut du compte"
    },
    "suspension_reason": {
      "type": "string",
      "description": "Raison de la suspension / ban"
    },
    "suspension_until": {
      "type": "string",
      "format": "date",
      "description": "Date de fin de suspension temporaire"
    }
  },
  "required": []
}