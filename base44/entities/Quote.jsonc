{
  "name": "Quote",
  "type": "object",
  "properties": {
    "client_name": {
      "type": "string",
      "description": "Nom complet du client"
    },
    "client_email": {
      "type": "string",
      "description": "Email du client"
    },
    "client_phone": {
      "type": "string",
      "description": "T\u00e9l\u00e9phone"
    },
    "company": {
      "type": "string",
      "description": "Soci\u00e9t\u00e9 (optionnel)"
    },
    "service_type": {
      "type": "string",
      "enum": [
        "video_evenement",
        "inspection_toiture",
        "suivi_chantier",
        "captation_particulier",
        "captation_entreprise",
        "retour_temps_reel",
        "autre"
      ],
      "description": "Type de prestation"
    },
    "date_souhaitee": {
      "type": "string",
      "format": "date",
      "description": "Date souhait\u00e9e"
    },
    "horaire": {
      "type": "string",
      "description": "Horaire souhait\u00e9"
    },
    "location": {
      "type": "string",
      "description": "Lieu de la prestation"
    },
    "description": {
      "type": "string",
      "description": "Description d\u00e9taill\u00e9e du besoin"
    },
    "duree_estimee": {
      "type": "string",
      "enum": [
        "1h",
        "2-3h",
        "demi-journee",
        "journee",
        "multi-jours"
      ],
      "description": "Dur\u00e9e estim\u00e9e"
    },
    "fichiers_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Fichiers upload\u00e9s"
    },
    "prix_estime": {
      "type": "number",
      "description": "Prix estimatif calcul\u00e9"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "reviewing",
        "accepted",
        "refused",
        "completed"
      ],
      "default": "pending",
      "description": "Statut du devis"
    },
    "admin_notes": {
      "type": "string",
      "description": "Notes admin"
    },
    "prix_final": {
      "type": "number",
      "description": "Prix final propos\u00e9"
    }
  },
  "required": [
    "client_name",
    "client_email",
    "service_type"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.client_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.client_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}