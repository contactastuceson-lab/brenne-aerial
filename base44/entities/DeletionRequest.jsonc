{
  "name": "DeletionRequest",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "user_email": {
      "type": "string"
    },
    "user_name": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "processed",
        "cancelled"
      ],
      "default": "pending"
    }
  },
  "required": [
    "user_email"
  ]
}