      "description": "Badges attribu\u00e9s"
    },
    "phone": {
      "type": "string"
    },
    "company": {
      "type": "string"
    },
    "bio": {
      "type": "string"
    },
    "avatar_url": {
      "type": "string"
    },
    "social_tiktok": {
      "type": "string"
    },
    "social_instagram": {
      "type": "string"
    },
