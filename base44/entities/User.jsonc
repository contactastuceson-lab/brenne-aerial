{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "owner",
        "pdg_adjoint",
        "admin",
        "conseil_admin",
        "directeur",
        "responsable",
        "collaborateur_interne",
        "user",
        "vip",
        "collaborateur",
        "pilote"
      ],
      "default": "user",
      "description": "R\u00f4le de l'utilisateur. owner = PDG/propri\u00e9taire exclusif. pdg_adjoint = PDG-Adjoint avec pouvoirs \u00e9quivalents. conseil_admin = Conseil d'Administration. directeur = Directeur de d\u00e9partement. responsable = Responsable de service. collaborateur_interne = Collaborateur interne."
    },
    "avatar_url": {
      "type": "string"
    },
    "cover_url": {
      "type": "string"
    },
    "bio": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "website": {
      "type": "string"
    },
    "badges": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verifications": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verified_status": {
      "type": "string",
      "enum": [
        "yes",
        "no"
      ],
      "default": "no"
    },
    "account_status": {
      "type": "string",
      "enum": [
        "active",
        "suspended",
        "banned",
        "restricted"
      ],
      "default": "active"
    },
    "suspension_reason": {
      "type": "string"
    },
    "suspension_until": {
      "type": "string",
      "format": "date"
    },
    "last_seen": {
      "type": "string",
      "format": "date-time"
    },
    "department": {
      "type": "string",
      "description": "D\u00e9partement / p\u00f4le de l'utilisateur (ex: Communication, Technique, Commercial)"
    },
    "title": {
      "type": "string",
      "description": "Titre officiel (ex: Directeur Technique, Responsable Commercial)"
    }
  },
  "required": [
    "avatar_url",
    "cover_url",
    "bio",
    "phone",
    "location",
    "website",
    "badges",
    "verifications",
    "suspension_reason",
    "suspension_until",
    "last_seen"
  ]
}