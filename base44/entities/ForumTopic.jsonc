{
  "name": "ForumTopic",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Titre du sujet"
    },
    "content": {
      "type": "string",
      "description": "Contenu principal du sujet"
    },
    "category": {
      "type": "string",
      "enum": [
        "general",
        "technique",
        "aide",
        "partages",
        "autres"
      ],
      "default": "general",
      "description": "Cat\u00e9gorie du sujet"
    },
    "author": {
      "type": "string",
      "description": "ID de l'auteur"
    },
    "author_name": {
      "type": "string",
      "description": "Nom de l'auteur"
    },
    "author_username": {
      "type": "string",
      "description": "Username de l'auteur (persistent m\u00eame apr\u00e8s suppression du compte)"
    },
    "author_email": {
      "type": "string",
      "description": "Email de l'auteur"
    },
    "author_avatar_url": {
      "type": "string",
      "description": "Avatar URL de l'auteur (sauvegard\u00e9 pour fallback)"
    },
    "author_badges": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Badges de l'auteur au moment de la cr\u00e9ation"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Tags du sujet"
    },
    "views_count": {
      "type": "number",
      "default": 0,
      "description": "Nombre de vues"
    },
    "replies_count": {
      "type": "number",
      "default": 0,
      "description": "Nombre de r\u00e9ponses"
    },
    "is_pinned": {
      "type": "boolean",
      "default": false,
      "description": "Sujet \u00e9pingl\u00e9"
    },
    "is_locked": {
      "type": "boolean",
      "default": false,
      "description": "Sujet ferm\u00e9"
    },
    "last_reply_at": {
      "type": "string",
      "format": "date-time",
      "description": "Date de la derni\u00e8re r\u00e9ponse"
    }
  },
  "required": [
    "title",
    "content",
    "author"
  ]
}