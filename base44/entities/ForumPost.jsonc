{
  "name": "ForumPost",
  "type": "object",
  "properties": {
    "topic_id": {
      "type": "string",
      "description": "ID du sujet parent"
    },
    "content": {
      "type": "string",
      "description": "Contenu de la r\u00e9ponse"
    },
    "author": {
      "type": "string",
      "description": "ID de l'auteur"
    },
    "author_name": {
      "type": "string",
      "description": "Nom de l'auteur"
    },
    "author_username": {
      "type": "string",
      "description": "Username de l'auteur (persistent m\u00eame apr\u00e8s suppression du compte)"
    },
    "author_email": {
      "type": "string",
      "description": "Email de l'auteur"
    },
    "author_avatar_url": {
      "type": "string",
      "description": "Avatar URL de l'auteur (sauvegard\u00e9 pour fallback)"
    },
    "author_badges": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Badges de l'auteur au moment de la cr\u00e9ation"
    },
    "is_solution": {
      "type": "boolean",
      "default": false,
      "description": "Est une solution marqu\u00e9e"
    },
    "likes_count": {
      "type": "number",
      "default": 0,
      "description": "Nombre de J'aime"
    }
  },
  "required": [
    "topic_id",
    "content",
    "author"
  ]
}