{
  "name": "ForumTopic",
  "type": "object",
  "description": "Sujet de discussion du forum",
  "properties": {
    "title": {
      "type": "string",
      "description": "Titre du sujet"
    },
    "content": {
      "type": "string",
      "description": "Contenu initial du sujet/question"
    },
    "category": {
      "type": "string",
      "enum": [
        "general",
        "techniques",
        "projets",
        "services",
        "formation",
        "actualites",
        "support"
      ],
      "default": "general",
      "description": "Catégorie du sujet"
    },
    "author": {
      "type": "string",
      "description": "ID de l'auteur (référence User)"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Tags pour catégoriser"
    },
    "is_pinned": {
      "type": "boolean",
      "default": false,
      "description": "Épingler en haut du forum"
    },
    "is_locked": {
      "type": "boolean",
      "default": false,
      "description": "Les réponses sont fermées"
    },
    "views_count": {
      "type": "number",
      "default": 0,
      "description": "Nombre de vues"
    },
    "replies_count": {
      "type": "number",
      "default": 0,
      "description": "Nombre de réponses"
    },
    "last_reply_at": {
      "type": "string",
      "format": "date-time",
      "description": "Date de la dernière réponse"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "title",
    "content",
    "author"
  ]
}
