{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "user",
        "admin",
        "owner",
        "vip",
        "collaborateur",
        "pilote",
        "collaborateur_interne",
        "responsable",
        "directeur",
        "conseil_admin",
        "pdg_adjoint"
      ],
      "default": "user"
    },
    "username": {
      "type": "string",
      "description": "Username unique et public (lowercase)"
    },
    "display_name": {
      "type": "string",
      "description": "Nom d'affichage du profil"
    },
    "bio": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "website": {
      "type": "string"
    },
    "avatar_url": {
      "type": "string"
    },
    "cover_url": {
      "type": "string"
    },
    "badges": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verifications": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "certified_affiliation_sources": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Liste des organisations ayant attribué le badge certifié par affiliation"
    },
    "verified_status": {
      "type": "string",
      "enum": [
        "yes",
        "no",
        "pending"
      ],
      "default": "no"
    },
    "account_status": {
      "type": "string",
      "enum": [
        "active",
        "suspended",
        "banned",
        "restricted"
      ],
      "default": "active"
    },
    "two_factor_enabled": {
      "type": "boolean",
      "default": false
    },
    "totp_secret": {
      "type": "string"
    },
    "notification_preferences": {
      "type": "object"
    },
    "ui_preferences": {
      "type": "object"
    }
  },
  "required": [
    "username",
    "display_name",
    "bio",
    "phone",
    "location",
    "website",
    "avatar_url",
    "cover_url",
    "badges",
    "verifications",
    "totp_secret",
    "notification_preferences",
    "ui_preferences"
  ]
}