{
  "name": "Report",
  "type": "object",
  "properties": {
    "reporter_email": {
      "type": "string",
      "description": "Email du signaleur"
    },
    "reporter_name": {
      "type": "string"
    },
    "target_type": {
      "type": "string",
      "enum": [
        "user",
        "message",
        "post",
        "discussion",
        "discussion_reply",
        "forum_topic",
        "forum_post",
        "community",
        "space",
        "story",
        "event",
        "review"
      ],
      "description": "Type de cible signal\u00e9e"
    },
    "target_id": {
      "type": "string",
      "description": "ID de la cible (user id, post id, message id, etc.)"
    },
    "target_email": {
      "type": "string",
      "description": "Email de l'auteur du contenu signal\u00e9 (si applicable)"
    },
    "target_name": {
      "type": "string",
      "description": "Nom de l'auteur du contenu signal\u00e9"
    },
    "target_content_preview": {
      "type": "string",
      "description": "Aper\u00e7u du contenu signal\u00e9 (snapshot texte)"
    },
    "target_url": {
      "type": "string",
      "description": "Lien vers le contenu signal\u00e9 (si applicable)"
    },
    "target_context": {
      "type": "string",
      "description": "Contexte lisible du contenu signal\u00e9 (ex: 'Publication dans le fil', 'R\u00e9ponse dans Discussion: titre', 'Sujet du forum')"
    },
    "reason": {
      "type": "string",
      "enum": [
        "spam",
        "harcelement",
        "contenu_inapproprie",
        "usurpation",
        "discours_haineux",
        "violence",
        "mise_en_danger",
        "illegal",
        "autre"
      ],
      "description": "Raison du signalement"
    },
    "details": {
      "type": "string",
      "description": "D\u00e9tails suppl\u00e9mentaires"
    },
    "message_content": {
      "type": "string",
      "description": "Contenu du message signal\u00e9 (snapshot complet, si applicable)"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "reviewed",
        "resolved",
        "dismissed"
      ],
      "default": "pending"
    },
    "admin_notes": {
      "type": "string"
    }
  },
  "required": [
    "reporter_email",
    "target_type",
    "target_id",
    "reason"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.reporter_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "owner"
          }
        },
        {
          "user_condition": {
            "role": "pdg_adjoint"
          }
        },
        {
          "user_condition": {
            "role": "conseil_admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.reporter_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "owner"
          }
        },
        {
          "user_condition": {
            "role": "pdg_adjoint"
          }
        },
        {
          "user_condition": {
            "role": "conseil_admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "owner"
          }
        },
        {
          "user_condition": {
            "role": "pdg_adjoint"
          }
        },
        {
          "user_condition": {
            "role": "conseil_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "owner"
          }
        },
        {
          "user_condition": {
            "role": "pdg_adjoint"
          }
        },
        {
          "user_condition": {
            "role": "conseil_admin"
          }
        }
      ]
    }
  }
}