{
  "name": "Referral",
  "type": "object",
  "properties": {
    "referrer_email": {
      "type": "string",
      "description": "Email du parrain"
    },
    "referrer_name": {
      "type": "string"
    },
    "referral_code": {
      "type": "string",
      "description": "Code unique de parrainage (username du parrain)"
    },
    "referred_name": {
      "type": "string",
      "description": "Nom du filleul (rempli quand il rejoint la plateforme)"
    },
    "referred_email": {
      "type": "string",
      "description": "Email du filleul"
    },
    "referred_phone": {
      "type": "string"
    },
    "referred_user_id": {
      "type": "string",
      "description": "ID de l'utilisateur filleul"
    },
    "mission_description": {
      "type": "string",
      "description": "Description de la mission"
    },
    "credits_earned": {
      "type": "number",
      "default": 0,
      "description": "Cr\u00e9dits Eza gagn\u00e9s par le parrain"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "validated",
        "rewarded"
      ],
      "default": "pending"
    },
    "admin_notes": {
      "type": "string"
    }
  },
  "required": [
    "referrer_email",
    "referrer_name",
    "referral_code"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.referrer_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.referrer_email": "{{user.email}}"
        },
        {
          "data.referred_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}