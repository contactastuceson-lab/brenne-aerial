{
  "name": "AuditLog",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email de l'utilisateur"
    },
    "user_name": {
      "type": "string",
      "description": "Nom de l'utilisateur"
    },
    "action": {
      "type": "string",
      "enum": [
        "create",
        "update",
        "delete",
        "read",
        "login",
        "logout"
      ],
      "description": "Type d'action"
    },
    "entity_type": {
      "type": "string",
      "description": "Type d'entit\u00e9 concern\u00e9e (ex: Quote, Appointment)"
    },
    "entity_id": {
      "type": "string",
      "description": "ID de l'entit\u00e9"
    },
    "changes": {
      "type": "object",
      "description": "D\u00e9tails des changements (ancien/nouveau)"
    },
    "ip_address": {
      "type": "string",
      "description": "Adresse IP"
    },
    "user_agent": {
      "type": "string",
      "description": "User agent du navigateur"
    },
    "status": {
      "type": "string",
      "enum": [
        "success",
        "failure"
      ],
      "default": "success"
    },
    "error_message": {
      "type": "string"
    }
  },
  "required": [
    "user_email",
    "action",
    "entity_type"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "owner"
          }
        },
        {
          "user_condition": {
            "role": "pdg_adjoint"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "owner"
      }
    },
    "delete": {
      "user_condition": {
        "role": "owner"
      }
    }
  }
}