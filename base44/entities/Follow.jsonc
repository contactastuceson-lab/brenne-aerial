{
  "name": "Follow",
  "type": "object",
  "properties": {
    "follower_email": {
      "type": "string",
      "description": "Email de celui qui suit"
    },
    "follower_name": {
      "type": "string",
      "description": "Nom de celui qui suit"
    },
    "follower_avatar": {
      "type": "string",
      "description": "Avatar de celui qui suit"
    },
    "following_email": {
      "type": "string",
      "description": "Email de celui qui est suivi"
    },
    "following_name": {
      "type": "string",
      "description": "Nom de celui qui est suivi"
    }
  },
  "required": [
    "follower_email",
    "following_email"
  ],
  "rls": {
    "create": {
      "data.follower_email": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "data.follower_email": "{{user.email}}"
        },
        {
          "data.following_email": "{{user.email}}"
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "data.follower_email": "{{user.email}}"
    }
  }
}