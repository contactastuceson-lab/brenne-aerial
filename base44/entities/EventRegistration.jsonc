{
  "name": "EventRegistration",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "description": "ID de l'\u00e9v\u00e9nement"
    },
    "event_title": {
      "type": "string",
      "description": "Titre de l'\u00e9v\u00e9nement (snapshot)"
    },
    "event_image_url": {
      "type": "string",
      "description": "Image de l'\u00e9v\u00e9nement (snapshot)"
    },
    "event_start_date": {
      "type": "string",
      "format": "date-time",
      "description": "Date de d\u00e9but (snapshot)"
    },
    "event_city": {
      "type": "string",
      "description": "Ville (snapshot)"
    },
    "user_id": {
      "type": "string",
      "description": "ID de l'utilisateur inscrit"
    },
    "user_email": {
      "type": "string",
      "description": "Email (snapshot)"
    },
    "user_name": {
      "type": "string",
      "description": "Nom (snapshot)"
    },
    "user_username": {
      "type": "string",
      "description": "Username (snapshot)"
    },
    "credits_paid": {
      "type": "number",
      "default": 0,
      "description": "Cr\u00e9dits Eza d\u00e9bit\u00e9s \u00e0 l'inscription"
    },
    "status": {
      "type": "string",
      "enum": [
        "registered",
        "cancelled",
        "refunded"
      ],
      "default": "registered",
      "description": "registered = inscrit, cancelled = annul\u00e9 sans remboursement, refunded = rembours\u00e9 (cr\u00e9dits rendus)"
    },
    "ticket_code": {
      "type": "string",
      "description": "Code court du billet (ex: EZA-AB12CD34)"
    },
    "registered_at": {
      "type": "string",
      "format": "date-time",
      "description": "Date d'inscription"
    },
    "checked_in": {
      "type": "boolean",
      "default": false,
      "description": "Billet valid\u00e9 / participant entr\u00e9"
    },
    "checked_in_at": {
      "type": "string",
      "format": "date-time",
      "description": "Date de validation d'entr\u00e9e"
    },
    "cancelled_at": {
      "type": "string",
      "format": "date-time",
      "description": "Date d'annulation / remboursement"
    },
    "refund_note": {
      "type": "string",
      "description": "Note admin sur le remboursement"
    },
    "refunded_by": {
      "type": "string",
      "description": "Email de l'admin ayant rembours\u00e9"
    },
    "cancel_request_reason": {
      "type": "string",
      "description": "Motif de la demande d'annulation (utilisateur)"
    },
    "cancel_request_status": {
      "type": "string",
      "enum": [
        "none",
        "pending",
        "approved",
        "rejected"
      ],
      "default": "none",
      "description": "none = pas de demande, pending = en attente admin, approved = approuv\u00e9e, rejected = refus\u00e9e"
    },
    "cancel_requested_at": {
      "type": "string",
      "format": "date-time",
      "description": "Date de la demande d'annulation"
    },
    "cancel_decision_note": {
      "type": "string",
      "description": "Note admin sur la d\u00e9cision d'annulation"
    },
    "cancel_decided_at": {
      "type": "string",
      "format": "date-time",
      "description": "Date de la d\u00e9cision admin"
    },
    "cancel_decided_by": {
      "type": "string",
      "description": "Email de l'admin ayant d\u00e9cid\u00e9"
    }
  },
  "required": [
    "event_id",
    "user_id",
    "status"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "event_manager"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "event_manager"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}