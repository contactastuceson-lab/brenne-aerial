{
  "name": "DiscussionReply",
  "type": "object",
  "properties": {
    "discussion_id": {
      "type": "string",
      "description": "ID de la discussion"
    },
    "content": {
      "type": "string",
      "description": "Contenu de la r\u00e9ponse"
    },
    "author_id": {
      "type": "string",
      "description": "ID de l'auteur"
    },
    "author_name": {
      "type": "string",
      "description": "Nom de l'auteur (snapshot)"
    },
    "author_display_name": {
      "type": "string",
      "description": "Nom d'affichage de l'auteur (snapshot)"
    },
    "author_avatar": {
      "type": "string",
      "description": "Avatar de l'auteur (snapshot)"
    },
    "author_is_supreme": {
      "type": "boolean",
      "default": false,
      "description": "L'auteur a le statut Supr\u00eame"
    },
    "author_verifications": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Certifications de l'auteur (verified, certified, official, pro)"
    },
    "likes_count": {
      "type": "number",
      "default": 0
    },
    "liked_by": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs des utilisateurs qui ont aim\u00e9"
    },
    "is_solution": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "discussion_id",
    "content",
    "author_id"
  ]
}