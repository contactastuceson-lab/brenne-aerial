{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "user",
        "admin",
        "owner",
        "vip",
        "collaborateur",
        "pilote",
        "collaborateur_interne",
        "responsable",
        "directeur",
        "conseil_admin",
        "pdg_adjoint"
      ],
      "default": "user"
    },
    "username": {
      "type": "string",
      "description": "Username unique et public (lowercase)"
    },
    "display_name": {
      "type": "string",
      "description": "Nom d'affichage du profil"
    },
    "bio": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "website": {
      "type": "string"
    },
    "avatar_url": {
      "type": "string"
    },
    "cover_url": {
      "type": "string"
    },
    "badges": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verifications": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "certified_affiliation_sources": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Liste des organisations ayant attribu\u00e9 le badge certifi\u00e9 par affiliation"
    },
    "supreme_assigned_at": {
      "type": "string",
      "format": "date-time",
      "description": "Date d'attribution du statut Supr\u00eame"
    },
    "verified_status": {
      "type": "string",
      "enum": [
        "yes",
        "no",
        "pending"
      ],
      "default": "no"
    },
    "badges_eligible": {
      "type": "boolean",
      "default": true,
      "description": "Profil \u00e9ligible \u00e0 l'attribution de badges et v\u00e9rifications"
    },
    "badge_ineligibility_reason": {
      "type": "string",
      "description": "Raison de la non-\u00e9ligibilit\u00e9 aux badges"
    },
    "badge_ineligibility_set_at": {
      "type": "string",
      "format": "date-time",
      "description": "Date \u00e0 laquelle la non-\u00e9ligibilit\u00e9 a \u00e9t\u00e9 d\u00e9finie"
    },
    "badge_ineligibility_set_by": {
      "type": "string",
      "description": "Email de l'admin ayant d\u00e9fini la non-\u00e9ligibilit\u00e9"
    },
    "account_status": {
      "type": "string",
      "enum": [
        "active",
        "suspended",
        "banned",
        "restricted"
      ],
      "default": "active"
    },
    "two_factor_enabled": {
      "type": "boolean",
      "default": false
    },
    "totp_secret": {
      "type": "string"
    },
    "notification_preferences": {
      "type": "object"
    },
    "ui_preferences": {
      "type": "object"
    },
    "referral_credits": {
      "type": "number",
      "default": 0,
      "description": "Cr\u00e9dits de parrainage Eza gagn\u00e9s"
    },
    "perks": {
      "type": "object",
      "description": "Avantages issus de la boutique : dates d'expiration, flags et tokens utilisables",
      "properties": {
        "featured_until": {
          "type": "string",
          "format": "date-time"
        },
        "top_explorer_until": {
          "type": "string",
          "format": "date-time"
        },
        "vip_until": {
          "type": "string",
          "format": "date-time"
        },
        "premium_until": {
          "type": "string",
          "format": "date-time"
        },
        "business_until": {
          "type": "string",
          "format": "date-time"
        },
        "enterprise_until": {
          "type": "string",
          "format": "date-time"
        },
        "analytics_until": {
          "type": "string",
          "format": "date-time"
        },
        "scheduled_posts_until": {
          "type": "string",
          "format": "date-time"
        },
        "early_access_until": {
          "type": "string",
          "format": "date-time"
        },
        "storage_until": {
          "type": "string",
          "format": "date-time"
        },
        "custom_colors": {
          "type": "boolean"
        },
        "custom_animated_badge": {
          "type": "boolean"
        },
        "custom_notif_sound": {
          "type": "boolean"
        },
        "particle_effects": {
          "type": "boolean"
        },
        "custom_watermark": {
          "type": "boolean"
        },
        "founder_number": {
          "type": "number"
        },
        "founder_at": {
          "type": "string",
          "format": "date-time"
        },
        "tokens": {
          "type": "object",
          "properties": {
            "boost": {
              "type": "number",
              "default": 0
            },
            "pin_24h": {
              "type": "number",
              "default": 0
            },
            "pin_7d": {
              "type": "number",
              "default": 0
            },
            "community_pin": {
              "type": "number",
              "default": 0
            },
            "community_capacity": {
              "type": "number",
              "default": 0
            },
            "community_premium_design": {
              "type": "number",
              "default": 0
            },
            "community_space": {
              "type": "number",
              "default": 0
            },
            "sponsored_event": {
              "type": "number",
              "default": 0
            }
          }
        }
      }
    }
  },
  "required": [
    "username",
    "display_name",
    "bio",
    "phone",
    "location",
    "website",
    "avatar_url",
    "cover_url",
    "badges",
    "verifications",
    "totp_secret",
    "notification_preferences",
    "ui_preferences"
  ]
}