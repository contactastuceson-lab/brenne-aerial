{
  "name": "Bookmark",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "ID de l'utilisateur propri\u00e9taire du signet"
    },
    "post_id": {
      "type": "string",
      "description": "ID du post mis en signet"
    },
    "post_excerpt": {
      "type": "string",
      "description": "Aper\u00e7u du post (snapshot)"
    },
    "author_username": {
      "type": "string",
      "description": "Username de l'auteur du post (snapshot)"
    }
  },
  "required": [
    "user_id",
    "post_id"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "read": {
      "data.user_id": "{{user.id}}"
    },
    "update": {
      "data.user_id": "{{user.id}}"
    },
    "delete": {
      "data.user_id": "{{user.id}}"
    }
  }
}