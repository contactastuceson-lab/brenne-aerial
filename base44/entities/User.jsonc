{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "user",
        "admin"
      ],
      "default": "user"
    },
    "verified_status": {
      "type": "string",
      "enum": [
        "yes",
        "no"
      ],
      "default": "no",
      "description": "V\u00e9rification principale (compte v\u00e9rifi\u00e9)"
    },
    "verifications": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Types de v\u00e9rification : verified, certified, official, pro"
    },
    "badges": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Badges de l'utilisateur"
    },
    "bio": {
      "type": "string"
    },
    "avatar_url": {
      "type": "string"
    },
    "cover_url": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "website": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive",
        "suspended",
        "banned"
      ],
      "default": "active"
    },
    "last_active": {
      "type": "string",
      "format": "date-time"
    }
  }
}