{
  "name": "Appointment",
  "type": "object",
  "properties": {
    "quote_id": {
      "type": "string",
      "description": "ID du devis associ\u00e9"
    },
    "client_name": {
      "type": "string"
    },
    "client_email": {
      "type": "string"
    },
    "service_type": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "time_start": {
      "type": "string",
      "description": "Heure d\u00e9but ex: 09:00"
    },
    "time_end": {
      "type": "string",
      "description": "Heure fin ex: 11:00"
    },
    "location": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "scheduled",
        "confirmed",
        "completed",
        "cancelled"
      ],
      "default": "scheduled"
    },
    "notes": {
      "type": "string"
    },
    "google_event_id": {
      "type": "string",
      "description": "ID \u00e9v\u00e9nement Google Calendar"
    }
  },
  "required": [
    "date",
    "time_start"
  ]
}