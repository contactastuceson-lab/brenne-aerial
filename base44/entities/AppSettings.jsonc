{
  "name": "AppSettings",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "description": "Cl\u00e9 du param\u00e8tre (unique)"
    },
    "value": {
      "type": "string",
      "description": "Valeur du param\u00e8tre"
    },
    "label": {
      "type": "string",
      "description": "Libell\u00e9 lisible"
    },
    "description": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "boolean",
        "string",
        "number"
      ],
      "default": "boolean"
    }
  },
  "required": [
    "key"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}