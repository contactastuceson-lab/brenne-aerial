{
  "name": "Notification",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email du destinataire"
    },
    "title": {
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "quote_accepted",
        "quote_refused",
        "quote_pending",
        "new_message",
        "contact_request",
        "appointment",
        "system",
        "badge",
        "blog",
        "LIKE",
        "REPLY",
        "FOLLOW",
        "VERIFICATION",
        "MENTION"
      ]
    },
    "is_read": {
      "type": "boolean",
      "default": false
    },
    "link": {
      "type": "string"
    },
    "sender_id": {
      "type": "string",
      "description": "ID de l'utilisateur qui a fait l'action"
    },
    "sender_name": {
      "type": "string",
      "description": "Nom de l'exp\u00e9diteur (snapshot)"
    },
    "sender_avatar": {
      "type": "string",
      "description": "Avatar de l'exp\u00e9diteur (snapshot)"
    },
    "sender_username": {
      "type": "string",
      "description": "Username de l'exp\u00e9diteur"
    },
    "post_id": {
      "type": "string",
      "description": "ID du post concern\u00e9 (like, reply)"
    },
    "post_excerpt": {
      "type": "string",
      "description": "Aper\u00e7u court du post concern\u00e9"
    },
    "receiver_id": {
      "type": "string",
      "description": "ID du destinataire"
    }
  },
  "required": [
    "user_email",
    "type"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}