{
  "name": "UserPreferences",
  "type": "object",
  "description": "Stocke les préférences utilisateur (notifications, langue, thème, etc.)",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email de l'utilisateur (clé primaire)"
    },
    "language": {
      "type": "string",
      "enum": ["fr", "en", "es", "de"],
      "default": "fr",
      "description": "Langue préférée de l'utilisateur"
    },
    "theme": {
      "type": "string",
      "enum": ["auto", "light", "dark"],
      "default": "auto",
      "description": "Thème de l'interface utilisateur"
    },
    "compact_mode": {
      "type": "boolean",
      "default": false,
      "description": "Activer le mode compact de l'interface"
    },
    "show_online_status": {
      "type": "boolean",
      "default": true,
      "description": "Afficher le statut en ligne aux autres utilisateurs"
    },
    "email_notifications": {
      "type": "boolean",
      "default": true,
      "description": "Recevoir les notifications par email"
    },
    "push_notifications": {
      "type": "boolean",
      "default": true,
      "description": "Recevoir les notifications push"
    },
    "quote_updates": {
      "type": "boolean",
      "default": true,
      "description": "Notifications pour les mises à jour de devis"
    },
    "appointment_reminders": {
      "type": "boolean",
      "default": true,
      "description": "Rappels de rendez-vous"
    },
    "new_messages": {
      "type": "boolean",
      "default": true,
      "description": "Notifications pour les nouveaux messages"
    },
    "badge_awarded": {
      "type": "boolean",
      "default": true,
      "description": "Notifications quand un badge est reçu"
    },
    "donation_updates": {
      "type": "boolean",
      "default": true,
      "description": "Notifications pour les dons"
    },
    "newsletter": {
      "type": "boolean",
      "default": false,
      "description": "S'abonner à la newsletter"
    },
    "marketing_emails": {
      "type": "boolean",
      "default": false,
      "description": "Recevoir les emails marketing"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "Date de création"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "Date de dernière mise à jour"
    }
  },
  "required": ["user_email"]
}
