{
  "name": "Review",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "description": "ID du projet concern\u00e9"
    },
    "author_name": {
      "type": "string",
      "description": "Nom de l'auteur"
    },
    "author_email": {
      "type": "string",
      "description": "Email de l'auteur"
    },
    "author_avatar": {
      "type": "string",
      "description": "URL avatar de l'auteur"
    },
    "author_badges": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Badges de l'auteur"
    },
    "rating": {
      "type": "number",
      "description": "Note de 1 \u00e0 5"
    },
    "comment": {
      "type": "string",
      "description": "Commentaire"
    },
    "is_verified_client": {
      "type": "boolean",
      "default": false,
      "description": "Client v\u00e9rifi\u00e9 par l'admin"
    }
  },
  "required": [
    "project_id",
    "author_name",
    "rating"
  ]
}