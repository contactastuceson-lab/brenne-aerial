{
  "name": "Block",
  "type": "object",
  "properties": {
    "blocker_email": {
      "type": "string",
      "description": "Email de celui qui bloque"
    },
    "blocked_email": {
      "type": "string",
      "description": "Email de celui qui est bloqu\u00e9"
    }
  },
  "required": [
    "blocker_email",
    "blocked_email"
  ],
  "rls": {
    "create": {
      "data.blocker_email": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "data.blocker_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.blocker_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.blocker_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}