{
  "name": "Report",
  "type": "object",
  "properties": {
    "reporter_email": {
      "type": "string",
      "description": "Email du signaleur"
    },
    "reporter_name": {
      "type": "string"
    },
    "target_type": {
      "type": "string",
      "enum": [
        "user",
        "message"
      ],
      "description": "Type de cible signal\u00e9e"
    },
    "target_id": {
      "type": "string",
      "description": "ID de la cible (user id ou message id)"
    },
    "target_email": {
      "type": "string",
      "description": "Email de l'utilisateur signal\u00e9"
    },
    "target_name": {
      "type": "string",
      "description": "Nom de l'utilisateur signal\u00e9"
    },
    "reason": {
      "type": "string",
      "enum": [
        "spam",
        "harcelement",
        "contenu_inapproprie",
        "usurpation",
        "autre"
      ],
      "description": "Raison du signalement"
    },
    "details": {
      "type": "string",
      "description": "D\u00e9tails suppl\u00e9mentaires"
    },
    "message_content": {
      "type": "string",
      "description": "Contenu du message signal\u00e9 (si applicable)"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "reviewed",
        "resolved",
        "dismissed"
      ],
      "default": "pending"
    },
    "admin_notes": {
      "type": "string"
    }
  },
  "required": [
    "reporter_email",
    "target_type",
    "target_id",
    "reason"
  ]
}