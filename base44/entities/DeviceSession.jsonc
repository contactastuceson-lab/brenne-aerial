{
  "name": "DeviceSession",
  "type": "object",
  "properties": {
    "session_id": {
      "type": "string",
      "description": "Identifiant unique de la session"
    },
    "fingerprint": {
      "type": "string",
      "description": "Identifiant unique de l'appareil (localStorage)"
    },
    "user_email": {
      "type": "string",
      "description": "Email de l'utilisateur"
    },
    "device_name": {
      "type": "string",
      "description": "Nom de l'appareil (ex: macOS Chrome)"
    },
    "device_type": {
      "type": "string",
      "enum": [
        "desktop",
        "mobile",
        "tablet"
      ],
      "default": "desktop"
    },
    "browser": {
      "type": "string"
    },
    "os": {
      "type": "string"
    },
    "ip_address": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "country": {
      "type": "string"
    },
    "is_trusted": {
      "type": "boolean",
      "default": false
    },
    "last_activity": {
      "type": "string",
      "format": "date-time"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "user_email",
    "session_id"
  ]
}