{
  "name": "Referral",
  "type": "object",
  "properties": {
    "referrer_email": {
      "type": "string",
      "description": "Email du parrain"
    },
    "referrer_name": {
      "type": "string"
    },
    "referral_code": {
      "type": "string",
      "description": "Code unique de parrainage"
    },
    "referred_name": {
      "type": "string",
      "description": "Nom du filleul (rempli quand il utilise le lien)"
    },
    "referred_email": {
      "type": "string"
    },
    "referred_phone": {
      "type": "string"
    },
    "mission_description": {
      "type": "string",
      "description": "Description de la mission"
    },
    "credits_earned": {
      "type": "number",
      "default": 0,
      "description": "Cr\u00e9dits vol gagn\u00e9s (en minutes)"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "validated",
        "rewarded"
      ],
      "default": "pending"
    },
    "admin_notes": {
      "type": "string"
    }
  },
  "required": [
    "referrer_email",
    "referrer_name",
    "referral_code"
  ]
}