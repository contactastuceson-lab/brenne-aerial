{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "owner",
        "admin",
        "user",
        "vip",
        "collaborateur",
        "pilote"
      ],
      "default": "user",
      "description": "R\u00f4le de l'utilisateur. 'owner' = propri\u00e9taire exclusif de la plateforme."
    },
    "avatar_url": {
      "type": "string"
    },
    "cover_url": {
      "type": "string"
    },
    "bio": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "website": {
      "type": "string"
    },
    "badges": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verifications": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verified_status": {
      "type": "string",
      "enum": [
        "yes",
        "no"
      ],
      "default": "no"
    },
    "account_status": {
      "type": "string",
      "enum": [
        "active",
        "suspended",
        "banned",
        "restricted"
      ],
      "default": "active"
    },
    "suspension_reason": {
      "type": "string"
    },
    "suspension_until": {
      "type": "string",
      "format": "date"
    },
    "last_seen": {
      "type": "string",
      "format": "date-time"
    }
  }
}