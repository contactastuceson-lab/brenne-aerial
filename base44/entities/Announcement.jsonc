{
  "name": "Announcement",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Titre de l'annonce"
    },
    "content": {
      "type": "string",
      "description": "Contenu de l'annonce"
    },
    "type": {
      "type": "string",
      "enum": [
        "info",
        "warning",
        "success",
        "error"
      ],
      "default": "info",
      "description": "Type / couleur de l'annonce"
    },
    "display_mode": {
      "type": "string",
      "enum": [
        "banner",
        "popup",
        "both"
      ],
      "default": "banner",
      "description": "Mode d'affichage"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Annonce active ou non"
    },
    "target": {
      "type": "string",
      "enum": [
        "all",
        "users_only",
        "visitors_only"
      ],
      "default": "all",
      "description": "Cible de l'annonce"
    },
    "expires_at": {
      "type": "string",
      "format": "date",
      "description": "Date d'expiration (optionnel)"
    },
    "dismissible": {
      "type": "boolean",
      "default": true,
      "description": "L'utilisateur peut fermer l'annonce"
    },
    "link_url": {
      "type": "string",
      "description": "URL du bouton d'action (optionnel)"
    },
    "link_label": {
      "type": "string",
      "description": "Texte du bouton d'action (optionnel, d\u00e9faut: 'En savoir plus')"
    }
  },
  "required": [
    "content",
    "type"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}