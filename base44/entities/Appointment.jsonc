{
  "name": "Appointment",
  "type": "object",
  "properties": {
    "quote_id": {
      "type": "string",
      "description": "ID du devis associ\u00e9"
    },
    "client_name": {
      "type": "string"
    },
    "client_email": {
      "type": "string"
    },
    "service_type": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "time_start": {
      "type": "string",
      "description": "Heure d\u00e9but ex: 09:00"
    },
    "time_end": {
      "type": "string",
      "description": "Heure fin ex: 11:00"
    },
    "location": {
      "type": "string"
    },
    "contact_type": {
      "type": "string",
      "enum": [
        "telephone",
        "email",
        "presentiel"
      ],
      "description": "Type de contact souhait\u00e9 par le client"
    },
    "meeting_address": {
      "type": "string",
      "description": "Adresse du lieu de rendez-vous (si pr\u00e9sentiel)"
    },
    "status": {
      "type": "string",
      "enum": [
        "confirmed",
        "pending",
        "scheduled",
        "completed",
        "cancelled"
      ],
      "default": "confirmed",
      "description": "confirmed = cr\u00e9neau dispo publi\u00e9, pending = demande en attente d'approbation admin, scheduled = accept\u00e9, completed = termin\u00e9, cancelled = annul\u00e9/refus\u00e9"
    },
    "notes": {
      "type": "string"
    },
    "google_event_id": {
      "type": "string",
      "description": "ID \u00e9v\u00e9nement Outlook Calendar"
    }
  },
  "required": [
    "date",
    "time_start"
  ]
}